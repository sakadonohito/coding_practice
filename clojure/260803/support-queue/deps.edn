{:paths ["src"]

 :deps
 {org.clojure/clojure
  {:mvn/version "1.12.5"}}

 :aliases
 {:run
  {:main-opts ["-m" "support-queue.main"]}

  :test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.cognitect-labs/test-runner
    {:git/tag "v0.5.1"
     :git/sha "dfb30dd"}}
   :exec-fn cognitect.test-runner.api/test
   :exec-args {:dirs ["test"]}}}}
