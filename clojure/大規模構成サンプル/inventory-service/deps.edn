{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.0"}}

 :aliases
 {:run
  {:main-opts ["-m" "inventory-service.main"]}

  :dev
  {:extra-paths ["dev" "test"]}

  :test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.cognitect-labs/test-runner
    {:git/tag "v0.5.1"
     :git/sha "dfb30dd"}}
   :exec-fn cognitect.test-runner.api/test
   :exec-args {:dirs ["test"]}}

  :build
  {:deps
   {io.github.clojure/tools.build
    {:git/tag "v0.10.9"
     :git/sha "e405aac"}}
   :ns-default build}}}
