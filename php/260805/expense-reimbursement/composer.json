{
  "name": "example/expense-reimbursement",
  "type": "project",
  "require": {
    "php": "^8.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "cache-dir": ".cache/composer",
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "test:verbose": "phpunit --testdox",
    "check": [
      "@php -l src/ExpenseCategory.php",
      "@php -l src/ExpenseClaim.php",
      "@php -l src/ExpenseDecision.php",
      "@php -l src/ExpenseReport.php",
      "@php -l src/ReimbursementService.php",
      "@php -l tests/ReimbursementServiceTest.php"
    ]
  }
}
