{
  "name": "example/shipping-request",
  "description": "PHP 8.5 shipping request practice",
  "type": "project",
  "require": {
    "php": "^8.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "check": [
      "@php -l src/DeliveryMethod.php",
      "@php -l src/DeliveryStatus.php",
      "@php -l src/ShippingRequest.php",
      "@php -l src/ShippingRequestFactory.php",
      "@php -l src/ShippingService.php"
    ]
  }
}
