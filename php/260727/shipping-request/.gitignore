# ==========================================
# PHP / Composer
# ==========================================
# 外部ライブラリ（composer install で再生成されるためコミットしない）
vendor/

# Composer の実行ファイル（もしローカルにある場合）
composer.phar

# ==========================================
# PHPUnit / テストキャッシュ
# ==========================================
# PHPUnit のテスト実行キャッシュ（今回生成されている可能性があります）
.phpunit.result.cache
.phpunit.cache/

# テストカバレッジなどのレポート
/coverage/